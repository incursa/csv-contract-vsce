{
  "name": "csv-contract-vsce",
  "displayName": "Validation Workbench",
  "description": "Design and run reusable YAML validations for files and SQL Server tables.",
  "version": "0.27.0",
  "publisher": "incursa",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.110.0"
  },
  "preview": true,
  "pricing": "Free",
  "markdown": "github",
  "galleryBanner": {
    "color": "#2A3142",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/incursa/csv-contract-vsce.git"
  },
  "homepage": "https://github.com/incursa/csv-contract-vsce#readme",
  "bugs": {
    "url": "https://github.com/incursa/csv-contract-vsce/issues"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "csv",
    "data quality",
    "sql server",
    "contract testing",
    "yaml",
    "validation"
  ],
  "icon": "images/icon.png",
  "main": "./dist/node/extension.cjs",
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "csv-contract-vsce.updateRulePackPin",
        "title": "Preview and Update Rule-Pack Pin",
        "category": "Validation",
        "enablement": "!isWeb"
      },
      {
        "command": "csv-contract-vsce.openReviewPackage",
        "title": "Open Saved Review Package",
        "category": "Validation"
      },
      {
        "command": "csv-contract-vsce.compareReviewPackages",
        "title": "Compare Saved Review Packages",
        "category": "Validation"
      },
      {
        "command": "csv-contract-vsce.createFromCsv",
        "title": "Create Contract from CSV",
        "category": "Validation"
      },
      {
        "command": "csv-contract-vsce.runContract",
        "title": "Run Contract",
        "category": "Validation"
      },
      {
        "command": "csv-contract-vsce.openWorkbench",
        "title": "Open Workbench",
        "category": "Validation"
      },
      {
        "command": "csv-contract-vsce.openExplorer",
        "title": "Open Workspace Tests",
        "category": "Validation"
      },
      {
        "command": "csv-contract-vsce.runSelectedContracts",
        "title": "Run Selected Workspace Contracts",
        "category": "Validation",
        "icon": "$(run-all)"
      },
      {
        "command": "csv-contract-vsce.showWorkspaceReport",
        "title": "Show Workspace Report",
        "category": "Validation",
        "icon": "$(output)"
      },
      {
        "command": "csv-contract-vsce.refreshExplorer",
        "title": "Refresh Workspace Tests",
        "category": "Validation",
        "icon": "$(refresh)"
      },
      {
        "command": "csv-contract-vsce.openTargetInVsCode",
        "title": "Open Target in VS Code",
        "category": "Validation",
        "icon": "$(go-to-file)"
      },
      {
        "command": "csv-contract-vsce.openTargetExternally",
        "title": "Open Target Externally",
        "category": "Validation",
        "icon": "$(link-external)"
      },
      {
        "command": "csv-contract-vsce.compareCsv",
        "title": "Compare CSV Files Semantically",
        "category": "Validation"
      },
      {
        "command": "csv-contract-vsce.generateSqlServerValidation",
        "title": "Generate SQL Server Staging Validation",
        "category": "Validation"
      },
      {
        "command": "csv-contract-vsce.importSqlServerSchema",
        "title": "Import SQL Server Table Schema",
        "category": "Validation"
      },
      {
        "command": "csv-contract-vsce.configureSqlServerConnection",
        "title": "Configure SQL Server Connection",
        "category": "Validation"
      },
      {
        "command": "csv-contract-vsce.forgetSqlServerConnection",
        "title": "Forget SQL Server Connection",
        "category": "Validation"
      },
      {
        "command": "csv-contract-vsce.addSqlServerTarget",
        "title": "Add SQL Server Table or View",
        "category": "Validation"
      },
      {
        "command": "csv-contract-vsce.loadComparison",
        "title": "Load Comparison Setup",
        "category": "Validation"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "csvContractExplorer",
          "title": "Validation",
          "icon": "resources/csv-contract.svg"
        }
      ]
    },
    "views": {
      "csvContractExplorer": [
        {
          "id": "csvContractExplorer.contracts",
          "name": "Workspace Tests"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "csv-contract-vsce.updateRulePackPin",
          "when": "!isWeb"
        }
      ],
      "view/title": [
        {
          "command": "csv-contract-vsce.runSelectedContracts",
          "when": "view == csvContractExplorer.contracts",
          "group": "navigation@1"
        },
        {
          "command": "csv-contract-vsce.showWorkspaceReport",
          "when": "view == csvContractExplorer.contracts",
          "group": "navigation@2"
        },
        {
          "command": "csv-contract-vsce.refreshExplorer",
          "when": "view == csvContractExplorer.contracts",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "csv-contract-vsce.openTargetInVsCode",
          "when": "view == csvContractExplorer.contracts && viewItem == csvContractTarget",
          "group": "inline@1"
        },
        {
          "command": "csv-contract-vsce.openTargetExternally",
          "when": "view == csvContractExplorer.contracts && viewItem == csvContractTarget",
          "group": "inline@2"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "csv-contract-vsce.contractEditor",
        "displayName": "Validation Workbench",
        "selector": [
          {
            "filenamePattern": "*.csvtest.yaml"
          },
          {
            "filenamePattern": "*.csvtest.yml"
          },
          {
            "filenamePattern": "*.csvsuite.yaml"
          },
          {
            "filenamePattern": "*.csvsuite.yml"
          },
          {
            "filenamePattern": "*.validation.yaml"
          },
          {
            "filenamePattern": "*.validation.yml"
          },
          {
            "filenamePattern": "*.validationsuite.yaml"
          },
          {
            "filenamePattern": "*.validationsuite.yml"
          }
        ],
        "priority": "default"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "*.csvtest.yaml",
          "*.csvtest.yml"
        ],
        "url": "./schemas/csvtest.schema.json"
      },
      {
        "fileMatch": [
          "*.validation.yaml",
          "*.validation.yml"
        ],
        "url": "./schemas/validation.schema.json"
      },
      {
        "fileMatch": [
          "*.csvsuite.yaml",
          "*.csvsuite.yml"
        ],
        "url": "./schemas/csvsuite.schema.json"
      },
      {
        "fileMatch": [
          "*.validationsuite.yaml",
          "*.validationsuite.yml"
        ],
        "url": "./schemas/validationsuite.schema.json"
      },
      {
        "fileMatch": [
          "*.rulepack.yaml",
          "*.rulepack.yml"
        ],
        "url": "./schemas/rulepack.schema.json"
      },
      {
        "fileMatch": [
          "*.validationfixtures.yaml",
          "*.validationfixtures.yml"
        ],
        "url": "./schemas/validationfixtures.schema.json"
      }
    ],
    "configuration": {
      "title": "Validation Workbench",
      "properties": {
        "csvContract.defaultNullValues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ""
          ],
          "description": "Null markers added to contracts created from CSV files."
        },
        "csvContract.maxRetainedIssues": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Maximum issue details retained for Workbench runs and exports. Use 0 to retain all details. SQL aggregate rules report counts rather than one detail per matching row."
        },
        "csvContract.suiteParallelMembers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 4,
          "description": "Maximum suite test files executed at the same time. Additional files remain queued on the suite progress screen."
        },
        "csvContract.resultColorMode": {
          "type": "string",
          "enum": [
            "binary",
            "graded"
          ],
          "enumDescriptions": [
            "Show clean runs in green and any failed run in red.",
            "Show health as Clean, Limited impact, Moderate impact, or High impact with yellow and orange intermediate states. Hover to see the numeric score."
          ],
          "enumItemLabels": [
            "Red / green",
            "Gradient"
          ],
          "default": "binary",
          "description": "Choose red/green result colors or a graded health spectrum. Graded labels describe impact; hover to see the 0–100 heuristic. PASS/FAIL status and exit codes are unchanged."
        }
      }
    }
  },
  "activationEvents": [
    "onCommand:csv-contract-vsce.updateRulePackPin",
    "onCommand:csv-contract-vsce.openReviewPackage",
    "onCommand:csv-contract-vsce.compareReviewPackages",
    "onCustomEditor:csv-contract-vsce.contractEditor",
    "onCommand:csv-contract-vsce.createFromCsv",
    "onCommand:csv-contract-vsce.runContract",
    "onCommand:csv-contract-vsce.openWorkbench",
    "onView:csvContractExplorer.contracts",
    "onCommand:csv-contract-vsce.openExplorer",
    "onCommand:csv-contract-vsce.runSelectedContracts",
    "onCommand:csv-contract-vsce.showWorkspaceReport",
    "onCommand:csv-contract-vsce.refreshExplorer",
    "onCommand:csv-contract-vsce.openTargetInVsCode",
    "onCommand:csv-contract-vsce.openTargetExternally",
    "onCommand:csv-contract-vsce.compareCsv",
    "onCommand:csv-contract-vsce.generateSqlServerValidation",
    "onCommand:csv-contract-vsce.importSqlServerSchema",
    "onCommand:csv-contract-vsce.configureSqlServerConnection",
    "onCommand:csv-contract-vsce.forgetSqlServerConnection",
    "onCommand:csv-contract-vsce.addSqlServerTarget",
    "onCommand:csv-contract-vsce.loadComparison"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "build": "npm run clean && npm run check-types && npm run lint && node esbuild.mjs",
    "build:production": "npm run clean && npm run check-types && npm run lint && node esbuild.mjs --production",
    "test": "npm run build && node --test dist/test/**/*.test.cjs",
    "test:powershell": "npm run build:production && pwsh -NoProfile -File scripts/Test-PowerShellSuite.ps1",
    "test:webview": "npm run build && node scripts/webview-smoke.mjs",
    "test:web-extension": "npm run build:production && node scripts/web-extension-test.mjs",
    "test:semantic-parity": "pwsh -NoProfile -File scripts/Test-SemanticParity.ps1",
    "test:all": "npm run test && npm run test:powershell && npm run test:webview && npm run test:web-extension",
    "brand:build": "node scripts/build-brand-assets.mjs",
    "brand:verify": "node scripts/verify-brand-assets.mjs",
    "benchmark": "npm run build:production && pwsh -NoProfile -File scripts/Test-CsvContractPerformance.ps1 -Rows 100000 -Columns 100",
    "vscode:prepublish": "npm run build:production",
    "package:vsix": "npm run build:production && vsce package --out csv-contract-vsce.vsix",
    "package:standalone": "npm run build:production && node scripts/package-standalone.mjs",
    "publish:marketplace": "npm run build:production && vsce publish",
    "release:check": "npm run test:all && npm run brand:verify && npm run package:vsix",
    "cli": "node dist/cli/csv-contract.cjs",
    "watch": "node esbuild.mjs --watch"
  },
  "devDependencies": {
    "@incursa/ui-kit": "^1.9.0",
    "@types/jsdom": "^30.0.0",
    "@types/mssql": "^9.1.11",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.3.16",
    "@types/vscode": "^1.110.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.7.1",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.3",
    "jsdom": "^27.4.0",
    "papaparse": "^5.5.3",
    "playwright": "^1.59.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "msnodesqlv8": "^5.3.0",
    "mssql": "^11.0.1"
  },
  "allowScripts": {
    "msnodesqlv8@5.3.0": true
  }
}
