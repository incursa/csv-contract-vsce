{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/incursa/csv-contract-vsce/main/schemas/csvtest.schema.json",
  "title": "CSV Contract",
  "description": "Requirements and spot checks for one or more CSV files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schema"
  ],
  "properties": {
    "baseline": {
      "description": "Versioned schema expectation or a sidecar path relative to the containing contract/suite. Never updated by validation.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "baselineVersion",
            "revision",
            "capturedAt",
            "sourceKind",
            "captureMethod",
            "columns"
          ],
          "additionalProperties": false,
          "properties": {
            "baselineVersion": {
              "const": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "capturedAt": {
              "type": "string"
            },
            "sourceKind": {
              "enum": [
                "csv",
                "sql",
                "manual"
              ]
            },
            "captureMethod": {
              "enum": [
                "csv-header",
                "sql-metadata",
                "manual"
              ]
            },
            "object": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema",
                "name"
              ],
              "properties": {
                "schema": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            },
            "interpretation": {
              "$ref": "#/$defs/csvOptions"
            },
            "inference": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "rows"
              ],
              "properties": {
                "scope": {
                  "enum": [
                    "complete",
                    "sample"
                  ]
                },
                "rows": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "policy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "default": {
                  "enum": [
                    "allowed",
                    "warning",
                    "error"
                  ]
                },
                "order": {
                  "enum": [
                    "exact",
                    "ignore"
                  ]
                },
                "changes": {
                  "type": "object",
                  "additionalProperties": {
                    "enum": [
                      "allowed",
                      "warning",
                      "error"
                    ]
                  }
                },
                "columns": {
                  "type": "object",
                  "additionalProperties": {
                    "enum": [
                      "allowed",
                      "warning",
                      "error"
                    ]
                  }
                }
              }
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "ordinal"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "ordinal": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "sqlType": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "maxLength": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "precision": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "scale": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "nullable": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "identity": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "computed": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "primaryKeyOrdinal": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "observedType": {
                    "enum": [
                      "unknown",
                      "string",
                      "number"
                    ]
                  },
                  "observedNullable": {
                    "type": "boolean"
                  },
                  "collation": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "uniqueKeys": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "description": "Opaque annotations preserved by combine/split; no execution behavior. Do not store secrets."
    },
    "version": {
      "const": 1,
      "description": "CSV Contract format version."
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Optional CSV files tested by default. Relative paths resolve from this contract file.",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "csv": {
      "$ref": "#/$defs/csvOptions"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unique": {
          "type": "boolean",
          "default": true
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "nulls": {
          "enum": [
            "ignore",
            "equal",
            "fail"
          ]
        }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns"
      ],
      "properties": {
        "allowAdditionalColumns": {
          "type": "boolean",
          "default": true
        },
        "columnOrder": {
          "const": "exact",
          "description": "Require CSV headers to follow the declaration order in schema.columns."
        },
        "rowCount": {
          "$ref": "#/$defs/count"
        },
        "columnCount": {
          "$ref": "#/$defs/count"
        },
        "columns": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/column"
          }
        }
      }
    },
    "rowTests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rowTest"
      }
    },
    "rules": {
      "type": "array",
      "description": "Conditional rules evaluated against every CSV record. Warning rules do not fail validation.",
      "items": {
        "$ref": "#/$defs/csvConditionalRule"
      }
    },
    "groupRules": {
      "type": "array",
      "description": "Cross-row completeness rules evaluated independently for each group key.",
      "items": {
        "$ref": "#/$defs/groupRule"
      }
    },
    "sqlServer": {
      "$ref": "#/$defs/sqlServer"
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "A relative or absolute CSV file path. Relative paths resolve from the contract file."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "An HTTP or HTTPS URL that returns CSV content."
        }
      },
      "oneOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ]
    },
    "csvOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delimiter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "default": ","
        },
        "encoding": {
          "const": "utf-8",
          "default": "utf-8"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "default": "\""
        },
        "header": {
          "const": "required",
          "default": "required"
        },
        "nullValues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ""
          ]
        },
        "trimValues": {
          "type": "boolean",
          "default": false
        },
        "caseSensitive": {
          "type": "boolean",
          "default": true
        },
        "allowBlankRows": {
          "type": "boolean",
          "default": false
        },
        "allowRaggedRows": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "exact": {
          "type": "integer",
          "minimum": 0
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presence"
      ],
      "properties": {
        "presence": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "description": {
          "type": "string"
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notNull": {
              "type": "boolean"
            },
            "unique": {
              "type": "boolean"
            },
            "minLength": {
              "type": "integer",
              "minimum": 0
            },
            "maxLength": {
              "type": "integer",
              "minimum": 0
            },
            "matches": {
              "type": "string",
              "format": "regex"
            },
            "allowedValues": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "sqlServer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connection": {
          "type": "string",
          "minLength": 1,
          "description": "Secret-backed connection profile for the single-table form."
        },
        "integratedConnection": {
          "$ref": "#/$defs/sqlServerIntegratedConnection"
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "objectType": {
          "enum": [
            "table",
            "view"
          ],
          "description": "Optional display metadata for the selected database object."
        },
        "columnMap": {
          "$ref": "#/$defs/sqlServerColumnMap"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sqlServerTableTarget"
          }
        },
        "rowLocator": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "detailLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 100
        },
        "scope": {
          "$ref": "#/$defs/sqlServerScope"
        },
        "conditionalRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conditionalRule"
          }
        },
        "importedSchema": {
          "$ref": "#/$defs/importedSchema"
        }
      },
      "anyOf": [
        {
          "required": [
            "schema",
            "table"
          ]
        },
        {
          "required": [
            "targets"
          ]
        }
      ]
    },
    "sqlServerScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column",
        "parameter",
        "sqlType"
      ],
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1
        },
        "parameter": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "sqlType": {
          "type": "string",
          "description": "Safe SQL type for generated scripts, such as bigint, uniqueidentifier, or nvarchar(100)."
        },
        "valueEnvironment": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Environment variable that supplies the runtime scope value without storing it in the contract."
        }
      }
    },
    "sqlServerTableTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "table"
      ],
      "not": {
        "required": [
          "connection",
          "integratedConnection"
        ]
      },
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "connection": {
          "type": "string",
          "minLength": 1
        },
        "integratedConnection": {
          "$ref": "#/$defs/sqlServerIntegratedConnection"
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "objectType": {
          "enum": [
            "table",
            "view"
          ]
        },
        "columnMap": {
          "$ref": "#/$defs/sqlServerColumnMap"
        },
        "scope": {
          "$ref": "#/$defs/sqlServerScope"
        },
        "baseline": {
          "$ref": "#/properties/baseline"
        }
      }
    },
    "sqlServerIntegratedConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server",
        "database"
      ],
      "properties": {
        "server": {
          "type": "string",
          "minLength": 1,
          "description": "SQL Server host, optionally including a named instance."
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "odbcDriver": {
          "type": "string",
          "minLength": 1,
          "default": "ODBC Driver 18 for SQL Server"
        },
        "encrypt": {
          "type": "boolean",
          "default": true
        },
        "trustServerCertificate": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "Windows integrated connection using the current desktop user's credentials; contains no password and needs no saved profile."
    },
    "sqlServerColumnMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "Maps canonical contract column names to physical SQL Server column names."
    },
    "importedSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "sourceKind",
        "columns"
      ],
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "sourceKind": {
          "enum": [
            "create-table",
            "database-tracking",
            "database-knowledge"
          ]
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/importedColumn"
          }
        }
      }
    },
    "importedColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "name",
        "sqlType",
        "nullable"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sqlType": {
          "type": "string",
          "minLength": 1
        },
        "nullable": {
          "type": "boolean"
        },
        "identity": {
          "type": "boolean"
        },
        "computed": {
          "type": "boolean"
        },
        "maxLength": {
          "type": "integer",
          "minimum": -1
        },
        "precision": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "column",
            "operator"
          ],
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "enum": [
                "equals",
                "notEquals",
                "in",
                "notIn",
                "isNull",
                "notNull",
                "isBlank",
                "notBlank",
                "equalsColumn",
                "notEqualsColumn"
              ]
            },
            "value": {
              "type": "string"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "otherColumn": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        }
      ]
    },
    "conditionalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "expect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "default": "error"
        },
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "expect": {
          "$ref": "#/$defs/predicate"
        }
      }
    },
    "csvPredicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "column",
            "operator"
          ],
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "enum": [
                "equals",
                "notEquals",
                "in",
                "notIn",
                "isNull",
                "notNull",
                "isBlank",
                "notBlank",
                "equalsColumn",
                "notEqualsColumn",
                "contains",
                "notContains",
                "startsWith",
                "endsWith",
                "matches",
                "greaterThan",
                "greaterThanOrEqual",
                "lessThan",
                "lessThanOrEqual",
                "dateOnOrAfter",
                "dateOnOrBefore",
                "dateAfter",
                "dateBefore"
              ]
            },
            "value": {
              "type": [
                "string",
                "number"
              ]
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "otherColumn": {
              "type": "string",
              "minLength": 1
            },
            "relativeDate": {
              "type": "object",
              "properties": {
                "anchor": {
                  "enum": [
                    "today",
                    "now"
                  ]
                },
                "days": {
                  "minimum": -365000,
                  "type": "integer",
                  "maximum": 365000
                }
              },
              "additionalProperties": false,
              "required": [
                "anchor",
                "days"
              ]
            },
            "valueType": {
              "enum": [
                "string",
                "number",
                "boolean"
              ]
            },
            "caseSensitive": {
              "type": "boolean"
            },
            "decimalPlaces": {
              "minimum": 0,
              "type": "integer",
              "maximum": 15
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "operator": {
                    "enum": [
                      "equals",
                      "notEquals",
                      "contains",
                      "notContains",
                      "startsWith",
                      "endsWith",
                      "matches",
                      "greaterThan",
                      "greaterThanOrEqual",
                      "lessThan",
                      "lessThanOrEqual",
                      "dateOnOrAfter",
                      "dateOnOrBefore",
                      "dateAfter",
                      "dateBefore"
                    ]
                  }
                }
              },
              "then": {
                "anyOf": [
                  {
                    "required": [
                      "value"
                    ]
                  },
                  {
                    "required": [
                      "otherColumn"
                    ]
                  },
                  {
                    "required": [
                      "relativeDate"
                    ]
                  }
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "operator": {
                    "enum": [
                      "equals",
                      "notEquals",
                      "contains",
                      "notContains",
                      "startsWith",
                      "endsWith",
                      "matches"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "value"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "operator": {
                    "enum": [
                      "in",
                      "notIn"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "values"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "operator": {
                    "enum": [
                      "equalsColumn",
                      "notEqualsColumn"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "otherColumn"
                ]
              }
            },
            {
              "then": {
                "properties": {
                  "operator": {
                    "enum": [
                      "dateOnOrAfter",
                      "dateOnOrBefore",
                      "dateAfter",
                      "dateBefore"
                    ]
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "value"
                      ]
                    },
                    {
                      "required": [
                        "otherColumn"
                      ]
                    }
                  ]
                }
              },
              "if": {
                "required": [
                  "relativeDate"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/csvPredicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/csvPredicate"
              }
            }
          }
        }
      ]
    },
    "csvConditionalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "expect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "default": "error"
        },
        "when": {
          "$ref": "#/$defs/csvPredicate"
