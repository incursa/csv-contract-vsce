{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/incursa/csv-contract-vsce/main/schemas/csvtest.schema.json",
  "title": "CSV Contract",
  "description": "Requirements and spot checks for one or more CSV files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schema"
  ],
  "properties": {
    "version": {
      "const": 1,
      "description": "CSV Contract format version."
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Optional CSV files tested by default. Relative paths resolve from this contract file.",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "csv": {
      "$ref": "#/$defs/csvOptions"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unique": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns"
      ],
      "properties": {
        "allowAdditionalColumns": {
          "type": "boolean",
          "default": true
        },
        "rowCount": {
          "$ref": "#/$defs/count"
        },
        "columnCount": {
          "$ref": "#/$defs/count"
        },
        "columns": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/column"
          }
        }
      }
    },
    "rowTests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rowTest"
      }
    },
    "sqlServer": {
      "$ref": "#/$defs/sqlServer"
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "A relative or absolute CSV file path. Relative paths resolve from the contract file."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "An HTTP or HTTPS URL that returns CSV content."
        }
      },
      "oneOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ]
    },
    "csvOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delimiter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "default": ","
        },
        "encoding": {
          "const": "utf-8",
          "default": "utf-8"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "default": "\""
        },
        "header": {
          "const": "required",
          "default": "required"
        },
        "nullValues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ""
          ]
        },
        "trimValues": {
          "type": "boolean",
          "default": false
        },
        "caseSensitive": {
          "type": "boolean",
          "default": true
        },
        "allowBlankRows": {
          "type": "boolean",
          "default": false
        },
        "allowRaggedRows": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "exact": {
          "type": "integer",
          "minimum": 0
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presence"
      ],
      "properties": {
        "presence": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "description": {
          "type": "string"
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notNull": {
              "type": "boolean"
            },
            "unique": {
              "type": "boolean"
            },
            "minLength": {
              "type": "integer",
              "minimum": 0
            },
            "maxLength": {
              "type": "integer",
              "minimum": 0
            },
            "matches": {
              "type": "string",
              "format": "regex"
            },
            "allowedValues": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "sqlServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "table"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "table": { "type": "string", "minLength": 1 },
        "rowLocator": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "detailLimit": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 100 },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["column", "parameter", "sqlType"],
          "properties": {
            "column": { "type": "string", "minLength": 1 },
            "parameter": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "sqlType": {
              "type": "string",
              "description": "Safe SQL type for the generated required scope parameter, such as bigint, uniqueidentifier, or nvarchar(100)."
            }
          }
        },
        "conditionalRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/conditionalRule" }
        },
        "importedSchema": {
          "$ref": "#/$defs/importedSchema"
        }
      }
    },
    "importedSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formatVersion", "sourceKind", "columns"],
      "properties": {
        "formatVersion": { "const": 1 },
        "sourceKind": { "enum": ["create-table", "database-tracking", "database-knowledge"] },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/importedColumn" }
        }
      }
    },
    "importedColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "name", "sqlType", "nullable"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "sqlType": { "type": "string", "minLength": 1 },
        "nullable": { "type": "boolean" },
        "identity": { "type": "boolean" },
        "computed": { "type": "boolean" },
        "maxLength": { "type": "integer", "minimum": -1 },
        "precision": { "type": "integer", "minimum": 0 },
        "scale": { "type": "integer", "minimum": 0 }
      }
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["column", "operator"],
          "properties": {
            "column": { "type": "string", "minLength": 1 },
            "operator": {
              "enum": ["equals", "notEquals", "in", "notIn", "isNull", "notNull", "isBlank", "notBlank", "equalsColumn", "notEqualsColumn"]
            },
            "value": { "type": "string" },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "otherColumn": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/predicate" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/predicate" } }
          }
        }
      ]
    },
    "conditionalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expect"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "name": { "type": "string" },
        "severity": { "enum": ["error", "warning"], "default": "error" },
        "when": { "$ref": "#/$defs/predicate" },
        "expect": { "$ref": "#/$defs/predicate" }
      }
    },
    "rowTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "select",
        "expect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Stable machine-readable test identifier."
        },
        "name": {
          "type": "string"
        },
        "select": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "count": {
              "$ref": "#/$defs/count"
            },
            "cells": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "equals"
                ],
                "properties": {
                  "equals": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "count"
              ]
            },
            {
              "required": [
                "cells"
              ]
            }
          ]
        }
      }
    }
  }
}
