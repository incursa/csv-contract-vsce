{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incursa.dev/schemas/rulepack.schema.json",
  "title": "Validation rule pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "definitions"],
  "properties": {
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/definition" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "scalar": { "type": ["string", "number", "boolean", "null"] },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "default": { "$ref": "#/$defs/scalar" },
        "description": { "type": "string" }
      }
    },
    "use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ref", "sha256", "definition"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "definition": { "$ref": "#/$defs/id" },
        "parameters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": { "type": "array", "items": { "type": "object" } },
        "groupRules": { "type": "array", "items": { "type": "object" } },
        "orderedRules": { "type": "array", "items": { "type": "object" } },
        "groupTests": { "type": "array", "items": { "type": "object" } }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string" },
        "parameters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/parameter" }
        },
        "uses": { "type": "array", "items": { "$ref": "#/$defs/use" } },
        "fragment": { "$ref": "#/$defs/fragment" }
      },
      "anyOf": [
        { "required": ["uses"] },
        { "required": ["fragment"] }
      ]
    }
  }
}
